{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const e=process.env,r=e.CLAUDE_PLUGIN_ROOT||e.COPILOT_PLUGIN_ROOT||e.PLUGIN_ROOT||'';const n=process.platform==='win32'&&r[0]==='/'&&r[2]==='/'?r[1].toUpperCase()+':'+r.slice(2):r;import('node:url').then(u=>import(u.pathToFileURL(n+'/_runtime/hooks/bootstrap.mjs').href))\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
