{
  "name": "accessibility-audit-plugin",
  "version": "0.9.4",
  "private": true,
  "description": "Cross-platform Codex, Claude Code, Claude Desktop, Cursor, and GitHub Copilot plugin for structured WCAG 2.2 accessibility audits.",
  "author": {
    "name": "Radancy",
    "url": "https://github.com/radancy-pe"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carla-goncalves_radancy/accessibility-audit-plugin.git"
  },
  "homepage": "https://github.com/carla-goncalves_radancy/accessibility-audit-plugin#readme",
  "bugs": {
    "url": "https://github.com/carla-goncalves_radancy/accessibility-audit-plugin/issues"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "axe-core",
    "playwright",
    "cursor-plugin",
    "claude-code-plugin",
    "claude-desktop-plugin",
    "codex-plugin",
    "github-copilot-plugin",
    "copilot-cli-plugin"
  ],
  "type": "module",
  "bin": {
    "accessibility-audit": "dist/cli.js",
    "accessibility-audit-mcp": "dist/mcp.js"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    ".cursor-plugin/",
    "assets/",
    "commands/",
    "dist/",
    "docs/",
    "rules/",
    "skills/",
    ".claude-mcp.json",
    ".mcp.json",
    "mcp.json",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "audit.config.example.json"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "build:marketplace": "npm run build && node scripts/build-marketplace-payload.mjs",
    "package:claude-desktop": "npm run build:marketplace && node scripts/package-claude-desktop.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "cross-env RUN_BROWSER_INTEGRATION=1 vitest run tests/integration.test.ts",
    "test:watch": "vitest",
    "audit": "tsx src/cli.ts audit",
    "mcp": "tsx src/mcp.ts",
    "validate:marketplace": "node scripts/validate-marketplace-payload.mjs",
    "test:marketplace": "node scripts/smoke-marketplace-payload.mjs",
    "test:rai-marketplace": "node scripts/test-rai-ops-compatibility.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.62.1",
    "archiver": "^7.0.1",
    "axe-core": "4.13.0",
    "commander": "15.0.0",
    "exceljs": "4.4.0",
    "zod": "4.5.4"
  },
  "bundleDependencies": [
    "@modelcontextprotocol/sdk",
    "@playwright/test",
    "archiver",
    "axe-core",
    "commander",
    "exceljs",
    "zod"
  ],
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/archiver": "^6.0.3",
    "@types/node": "24.10.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
