{
  "name": "accessibility-audit-plugin",
  "version": "1.4.1",
  "private": true,
  "description": "Cross-platform Codex, Claude Code, Claude Desktop, Cursor, and GitHub Copilot plugin for structured WCAG 2.2 accessibility audits.",
  "author": {
    "name": "CarlasHub",
    "url": "https://github.com/CarlasHub"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlasHub/accessibility-audit-plugin.git"
  },
  "homepage": "https://carlashub.github.io/accessibility-audit-plugin/",
  "bugs": {
    "url": "https://github.com/CarlasHub/accessibility-audit-plugin/issues"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "axe-core",
    "playwright",
    "cursor-plugin",
    "claude-code-plugin",
    "claude-desktop-plugin",
    "codex-plugin",
    "github-copilot-plugin",
    "copilot-cli-plugin",
    "github-action"
  ],
  "type": "module",
  "bin": {
    "accessibility-audit": "dist/cli.js",
    "accessibility-audit-mcp": "dist/mcp.js"
  },
  "files": [
    ".agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".cursor-plugin/",
    "assets/",
    "commands/",
    "dist/",
    "docs/",
    "rules/",
    "skills/",
    ".claude-mcp.json",
    ".mcp.json",
    "mcp.json",
    "plugin.json",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "PRIVACY.md",
    "TERMS.md",
    "audit.config.example.json"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/verify-site-neutrality.mjs --require-dist && npm run site:build",
    "build:action": "npm run build && node scripts/clean-action-dist.mjs && ncc build dist/action-entry.js -o action/dist --no-source-map-register -e axe-core -e playwright -e playwright-core && node scripts/finalize-action-dist.mjs",
    "build:marketplace": "npm run build && node scripts/build-marketplace-payload.mjs",
    "site:dev": "vite site --host 127.0.0.1",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts --host 127.0.0.1",
    "package:claude-desktop": "npm run build:marketplace && node scripts/package-claude-desktop.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/integration.test.ts --exclude tests/html-report-browser.test.ts",
    "test:browser": "cross-env RUN_BROWSER_INTEGRATION=1 vitest run tests/integration.test.ts tests/html-report-browser.test.ts",
    "test:built-cli": "cross-env RUN_BROWSER_INTEGRATION=1 vitest run tests/integration.test.ts -t \"runs the documented npm audit command through the built CLI\"",
    "test:integration": "cross-env RUN_BROWSER_INTEGRATION=1 vitest run tests/integration.test.ts",
    "test:screen-reader:voiceover": "cross-env A11Y_SCREEN_READER=voiceover playwright test -c playwright.screen-reader.config.ts tests/screen-reader/voiceover.spec.ts",
    "test:screen-reader:nvda": "cross-env A11Y_SCREEN_READER=nvda playwright test -c playwright.screen-reader.config.ts tests/screen-reader/nvda.spec.ts",
    "test:action": "node scripts/smoke-action-bundle.mjs",
    "test:buggyland": "node scripts/verify-buggyland-regression.mjs",
    "test:buggyland:live": "node scripts/run-buggyland-regression.mjs",
    "test:watch": "vitest",
    "audit": "npm run build --silent && node dist/cli.js audit",
    "mcp": "tsx src/mcp.ts",
    "validate:marketplace": "node scripts/validate-marketplace-payload.mjs",
    "test:marketplace": "node scripts/smoke-marketplace-payload.mjs",
    "test:marketplace-compatibility": "node scripts/test-marketplace-compatibility.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "verify:site-neutrality": "node scripts/verify-site-neutrality.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "archiver": "^7.0.1",
    "axe-core": "4.13.0",
    "commander": "15.0.0",
    "exceljs": "4.4.0",
    "playwright": "1.63.0",
    "zod": "4.5.4"
  },
  "bundleDependencies": [
    "@modelcontextprotocol/sdk",
    "archiver",
    "axe-core",
    "commander",
    "exceljs",
    "playwright",
    "zod"
  ],
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@guidepup/guidepup": "0.34.0",
    "@guidepup/playwright": "0.19.1",
    "@guidepup/setup": "0.25.3",
    "@playwright/test": "1.63.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "24.13.3",
    "@vercel/ncc": "0.45.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
